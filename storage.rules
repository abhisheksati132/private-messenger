rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.email == userId
      );
    }

    // User profile avatar photos (Max 5MB, images only)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Encrypted audio voice recordings (Max 25MB)
    match /audio/{conversationId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('audio/.*') || request.resource.contentType == 'application/octet-stream');
    }

    // Chat attachments (Photos, documents, files - Max 50MB)
    match /attachments/{conversationId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Explicit deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
