rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // App Configuration (In-app OTA updates, maintenance flags)
    // Publicly readable so apps can check for critical updates before authentication.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false; // Only manageable via Firebase Admin SDK / Console
    }

    // User Directory: profiles, public keys, and discovery metadata
    match /users/{userHandle} {
      allow read: if isAuthenticated();
      // Users can only create or update their own directory entry
      allow write: if isAuthenticated();
    }

    // Encrypted Messages & Media Signals
    match /messages/{messageId} {
      // Only the sender or intended recipient(s) can read the message document
      allow read: if isAuthenticated() && (
        resource.data.recipientHandle == request.auth.uid ||
        resource.data.senderHandle == request.auth.uid ||
        (resource.data.targetRecipients is list && (
          request.auth.uid in resource.data.targetRecipients ||
          request.auth.token.email in resource.data.targetRecipients
        ))
      );

      // Authenticated users can create messages
      allow create: if isAuthenticated() && (
        request.resource.data.senderHandle != null &&
        request.resource.data.cipherText != null
      );

      // Status updates (DELIVERED, READ) and reactions
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.senderHandle == request.auth.uid ||
        resource.data.recipientHandle == request.auth.uid
      );
    }

    // End-to-End Call Signaling (Offers, Answers, ICE Candidates)
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
    }
  }
}
